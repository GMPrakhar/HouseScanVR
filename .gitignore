# Unity3D generated crash reports
sysinfo.txt
crashlytics-build.properties

# Large binaries: scans are user data, not source.
*.ply
*.spz
*.splat

# OS noise
.DS_Store
Thumbs.db

# JVM crash dumps from Gradle/IL2CPP failures
hs_err_pid*.log
replay_pid*.log
.utmp/
